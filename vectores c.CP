#include <iostream>
using namespace std;


int main() {
    int x[] = {1, 3, 10, 11};

    cout << "Posicion 0 contiene" << x[0] << endl;
    cout << "Posicion 1 contiene" << x[1] << endl;
    cout << "Posicion 2 contiene" << x[2] << endl;
    cout << "Posicion 3 contiene" << x[3] << endl;

    return 0;
}
